@model MovieActorFormViewModel
@{
    var isEdit = Model.IsEdit;
    var movieName = Model.MovieOptions.FirstOrDefault(o => o.Value == Model.Input.MovieId?.ToString())?.Text;
    var actorName = Model.ActorOptions.FirstOrDefault(o => o.Value == Model.Input.ActorId?.ToString())?.Text;
}
<form asp-controller="MovieActors" asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-movieId="@(isEdit ? Model.Input.MovieId : null)" asp-route-actorId="@(isEdit ? Model.Input.ActorId : null)"
      method="post" data-ajax-form data-draft-key="@(isEdit ? $"movie-actors:edit:{Model.Input.MovieId}:{Model.Input.ActorId}" : "movie-actors:new")"
      data-draft-mode="@(isEdit ? "edit" : "create")">
    <div class="modal-header">
        <h2 class="modal-title h5" id="app-modal-title">@(isEdit ? "Edit Role" : "Add New Role")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Exit" title="Exit (your entries are kept)"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="row g-3">
            @if (isEdit)
            {
                <input type="hidden" asp-for="Input.MovieId" />
                <input type="hidden" asp-for="Input.ActorId" />
                <div class="col-md-6">
                    <label class="form-label" for="role-movie">Movie</label>
                    <input class="form-control" id="role-movie" value="@movieName" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="role-actor">Actor</label>
                    <input class="form-control" id="role-actor" value="@actorName" disabled />
                </div>
                <div class="col-12">
                    <p class="form-text mt-0 mb-0">
                        A role's movie and actor can't be changed. To move it, delete the role and add a new one.
                    </p>
                </div>
            }
            else
            {
                <div class="col-md-6">
                    <label asp-for="Input.MovieId" class="form-label"></label>
                    <select asp-for="Input.MovieId" asp-items="Model.MovieOptions" class="form-select">
                        <option value="">Select a movie…</option>
                    </select>
                    <span asp-validation-for="Input.MovieId"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ActorId" class="form-label"></label>
                    <select asp-for="Input.ActorId" asp-items="Model.ActorOptions" class="form-select">
                        <option value="">Select an actor…</option>
                    </select>
                    <span asp-validation-for="Input.ActorId"></span>
                </div>
            }
            <div class="col-md-6">
                <label asp-for="Input.CharacterName" class="form-label"></label>
                <input asp-for="Input.CharacterName" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.CharacterName"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.BillingOrder" class="form-label"></label>
                <input asp-for="Input.BillingOrder" type="number" class="form-control" min="1" max="999" />
                <span asp-validation-for="Input.BillingOrder"></span>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="Input.IsLeadRole" class="form-check-input" role="switch" />
                    <label asp-for="Input.IsLeadRole" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-draft-discard>Close</button>
        <button type="submit" class="btn btn-dark">@(isEdit ? "Save changes" : "Add role")</button>
    </div>
</form>
