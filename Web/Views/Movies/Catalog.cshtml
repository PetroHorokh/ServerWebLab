@model List<MovieViewModel>
@{
    ViewData["Title"] = "Movies";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Movies</h1>
    <p class="text-muted mb-0">Pick a movie to see its details and join the conversation.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">No movies yet</h2>
        <p class="text-muted mb-0">Check back soon. The admins haven't added any movies so far.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var movie in Model)
        {
            <div class="col">
                <article class="card movie-card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-dark border">@movie.Genre</span>
                            @if (movie.Rating is { } rating)
                            {
                                <span class="rating">@rating.ToString("0.0")<span class="text-muted small fw-normal"> / 10</span></span>
                            }
                        </div>
                        <h2 class="h5 mb-1">@movie.Title</h2>
                        <p class="text-muted small mb-3">
                            @movie.ReleaseYear &middot; @movie.DurationMinutes min@(movie.Director is null ? "" : " · " + movie.Director)
                        </p>
                        @if (movie.Description is not null)
                        {
                            <p class="movie-card-description mb-3">@movie.Description</p>
                        }
                        @if (movie.Actors.Count > 0)
                        {
                            <p class="small text-muted mb-3">
                                Starring @string.Join(", ", movie.Actors.Take(3).Select(a => a.FullName))@(movie.Actors.Count > 3 ? " and others" : "")
                            </p>
                        }
                        <a class="btn btn-dark mt-auto stretched-link" asp-action="Details" asp-route-id="@movie.Id">Open movie page</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
