@model UserCreateModel
<div class="col-md-6">
    <label asp-for="Password" class="form-label"></label>
    <div class="password-field">
        <input asp-for="Password" class="form-control" autocomplete="new-password" data-draft-ignore />
        <partial name="_PasswordToggleButton" model="Html.IdFor(m => m.Password)" />
    </div>
    <div class="form-text">At least @DAL.Constraints.UserConstraints.PasswordMinLength characters, with an uppercase letter, a lowercase letter, a digit and a symbol.</div>
    <span asp-validation-for="Password"></span>
</div>
<div class="col-md-6">
    <label asp-for="ConfirmPassword" class="form-label"></label>
    <div class="password-field">
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" data-draft-ignore />
        <partial name="_PasswordToggleButton" model="Html.IdFor(m => m.ConfirmPassword)" />
    </div>
    <span asp-validation-for="ConfirmPassword"></span>
</div>
