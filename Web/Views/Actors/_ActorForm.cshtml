@model ActorFormViewModel
@{
    var editId = Model.EditId;
    var moviesDropdown = new MultiSelectDropdownViewModel
    {
        Id = Html.IdFor(m => m.Input.MovieIds),
        Name = Html.NameFor(m => m.Input.MovieIds),
        Label = "Movies",
        Placeholder = "Select the movies this actor had a role in",
        EmptyText = "There are no movies yet. Add some on the Movies page first.",
        Options = Model.MovieOptions,
    };
}
<form asp-controller="Actors" asp-action="@(editId is null ? "Create" : "Edit")" asp-route-id="@editId" method="post" data-ajax-form
      data-draft-key="@(editId is null ? "actors:new" : $"actors:edit:{editId}")" data-draft-mode="@(editId is null ? "create" : "edit")">
    <div class="modal-header">
        <h2 class="modal-title h5" id="app-modal-title">@(editId is null ? "Add New Actor" : "Edit Actor")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Exit" title="Exit (your entries are kept)"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.FirstName" class="form-label"></label>
                <input asp-for="Input.FirstName" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.FirstName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.LastName" class="form-label"></label>
                <input asp-for="Input.LastName" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.LastName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.DateOfBirth" class="form-label"></label>
                <input asp-for="Input.DateOfBirth" type="date" class="form-control" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Input.DateOfBirth"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Nationality" class="form-label"></label>
                <input asp-for="Input.Nationality" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Nationality"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Biography" class="form-label"></label>
                <textarea asp-for="Input.Biography" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Biography"></span>
            </div>
            <div class="col-12">
                <partial name="_MultiSelectDropdown" model="moviesDropdown" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-draft-discard>Close</button>
        <button type="submit" class="btn btn-dark">@(editId is null ? "Add actor" : "Save changes")</button>
    </div>
</form>
