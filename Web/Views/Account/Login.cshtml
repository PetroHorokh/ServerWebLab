@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-card card shadow-sm">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-1">Log in</h1>
        <p class="text-muted mb-4">Log in to write in the movie chats.</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <partial name="_PasswordToggleButton" model="Html.IdFor(m => m.Password)" />
                </div>
                <span asp-validation-for="Password"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-dark w-100">Log in</button>
        </form>

        <p class="text-muted text-center mt-4 mb-0">
            New here? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Create an account</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
