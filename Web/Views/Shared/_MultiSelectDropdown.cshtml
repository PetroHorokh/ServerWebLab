@model MultiSelectDropdownViewModel
@{
    var labelId = $"{Model.Id}-label";
}
<div class="multiselect" data-multiselect data-placeholder="@Model.Placeholder">
    <span class="form-label d-block" id="@labelId">@Model.Label</span>
    <div class="dropdown">
        <button type="button" class="form-select multiselect-toggle" id="@Model.Id"
                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                aria-labelledby="@labelId @Model.Id">
            <span class="multiselect-summary" data-multiselect-summary>@Model.Placeholder</span>
            <span class="badge rounded-pill bg-dark d-none" data-multiselect-count></span>
        </button>
        <div class="dropdown-menu multiselect-menu w-100 p-2 shadow">
            @if (Model.Options.Count == 0)
            {
                <p class="text-muted small mb-0 px-2 py-1">@Model.EmptyText</p>
            }
            else
            {
                <input type="search" class="form-control form-control-sm mb-2" placeholder="Search…"
                       aria-label="Search @Model.Label.ToLowerInvariant()" autocomplete="off" data-multiselect-search />
                <div class="multiselect-options" role="group" aria-labelledby="@labelId">
                    @for (var i = 0; i < Model.Options.Count; i++)
                    {
                        var option = Model.Options[i];
                        var optionId = $"{Model.Id}-{i}";
                        <div class="form-check multiselect-option" data-multiselect-option>
                            <input class="form-check-input" type="checkbox" id="@optionId"
                                   name="@Model.Name" value="@option.Value" checked="@option.Selected" />
                            <label class="form-check-label" for="@optionId">@option.Text</label>
                        </div>
                    }
                    <p class="text-muted small mb-0 px-2 py-1 d-none" data-multiselect-no-results>No matches.</p>
                </div>
            }
        </div>
    </div>
</div>
